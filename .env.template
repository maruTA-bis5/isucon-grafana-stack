# Grafana
GF_AUTH_GITHUB_ENABLED=true
GF_AUTH_GITHUB_CLIENT_ID=<your-client-id>
GF_AUTH_GITHUB_CLIENT_SECRET=<your-client-secret>
GF_AUTH_GITHUB_ALLOWED_ORGANIZATIONS=<your-allowed-organizations>
GF_AUTH_GITHUB_ROLE_ATTRIBUTE_PATH=<your-role-attribute-path>
GF_AUTH_GITHUB_SKIP_ORG_ROLE_SYNC=<your-skip-org-role-sync>
GF_SERVER_DOMAIN=localhost

# Alloy
ALLOY_BIND_IP=<your-bind-ip>
ALLOY_OTLP_USERNAME=<your-otlp-username>
ALLOY_OTLP_PASSWORD=<your-otlp-password>
